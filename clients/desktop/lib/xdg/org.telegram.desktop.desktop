[Desktop Entry]
Name=Chat
Comment=Private messaging
TryExec=Chat
Exec=Chat -- %U
Icon=com.privatechat.desktop
Terminal=false
StartupWMClass=TelegramDesktop
Type=Application
Categories=Chat;Network;InstantMessaging;Qt;
MimeType=x-scheme-handler/privatechat;x-scheme-handler/tonsite;
Keywords=privatechat;chat;im;messaging;messenger;sms;
Actions=quit;
DBusActivatable=true
SingleMainWindow=true
X-GNOME-UsesNotifications=true
X-GNOME-SingleWindow=true

[Desktop Action quit]
Exec=Chat -quit
Name=Quit Chat
Icon=application-exit
